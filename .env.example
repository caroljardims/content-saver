# Chrome Extension OAuth client (Cloud Console > Credentials > Chrome Extension)
WXT_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Web application OAuth client, used by Firefox/Edge via launchWebAuthFlow
WXT_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Optional: base64 public key that pins the extension ID during development
WXT_EXTENSION_KEY=
